{
  "name": "ellmos-controlcenter-mcp",
  "version": "0.3.0",
  "mcpName": "io.github.ellmos-ai/ellmos-controlcenter-mcp",
  "description": "Read-mostly MCP administration: local server, tool and skill discovery, capability bundles, dashboard, policy audits, and MCP profile resolution and config generation. Prepares configuration; does not change running sessions or enforce permissions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ellmos-controlcenter": "dist/index.js",
    "ellmos-controlcenter-dashboard": "dist/dashboard.js"
  },
  "files": [
    "dist/",
    "assets/",
    "data/capability-bundles.json",
    "data/policy-rules.json",
    "server.json",
    "llms.txt",
    "README.md",
    "README_de.md",
    "SECURITY.md",
    "START.md",
    "ARCHITECTURE.md",
    "ROADMAP.md",
    "STATE.md",
    "DECISIONS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "dashboard": "node dist/dashboard.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "control-plane",
    "mcp-control-plane",
    "mcp-client",
    "mcp-host",
    "mcp-profiles",
    "profile-management",
    "profile-switching",
    "capability-bundles",
    "tool-catalog",
    "tool-discovery",
    "ellmos",
    "claude",
    "claude-profiles",
    "codex",
    "provider-neutral",
    "ai-lab",
    "dashboard",
    "mcp-dashboard",
    "local-mcp",
    "mcp-registry",
    "policy-audit",
    "mcp-server"
  ],
  "author": "Lukas (BACH)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ellmos-ai/ellmos-controlcenter-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ellmos-ai/ellmos-controlcenter-mcp/issues"
  },
  "homepage": "https://github.com/ellmos-ai/ellmos-controlcenter-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "update-notifier": "^7.3.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "hono": "^4.13.0",
    "@hono/node-server": "^2.0.5",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.4.0",
    "qs": "^6.15.2",
    "vitest": "^3.2.7",
    "postcss": "^8.5.18"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
