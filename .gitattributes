# Normalize line endings so a Windows checkout does not report every tracked
# file as fully modified (phantom diff). Text files are stored with LF.
* text=auto eol=lf

# Windows-only helpers keep CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be touched by the normalizer.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
